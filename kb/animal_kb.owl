<owl:Ontology rdf:about="http://esame_icon.org/animal_kb.owl"/>

<owl:ObjectProperty rdf:about="#mangia">
  <rdfs:domain rdf:resource="#Animale"/>
  <rdfs:range rdf:resource="#Dieta"/>
</owl:ObjectProperty>

<owl:Class rdf:about="#Animale">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Dieta">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Carne">
  <rdfs:subClassOf rdf:resource="#Dieta"/>
</owl:Class>

<owl:Class rdf:about="#Vegetali">
  <rdfs:subClassOf rdf:resource="#Dieta"/>
</owl:Class>

<owl:Class rdf:about="#Carnivoro">
  <rdfs:subClassOf rdf:resource="#Animale"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Animale"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#mangia"/>
          <owl:someValuesFrom rdf:resource="#Carne"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#Erbivoro">
  <rdfs:subClassOf rdf:resource="#Animale"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Animale"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#mangia"/>
          <owl:someValuesFrom rdf:resource="#Vegetali"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#PredatoreAlfa">
  <rdfs:subClassOf rdf:resource="#Carnivoro"/>
</owl:Class>

